{
  "name": "@notrealstudio/nr-md",
  "version": "0.1.0",
  "description": "Markdown as structured data: headings become blocks, $key: value lines become attributes. Parser and serializer for the mdd/mdz block grammar.",
  "keywords": [
    "markdown",
    "parser",
    "serializer",
    "structured-data",
    "ast",
    "config",
    "frontmatter",
    "mdd",
    "mdz",
    "json5"
  ],
  "license": "MIT",
  "author": "Julian Garrett",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@notrealstudio/nr-json5": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Not-Real-Studio/nr-md.git"
  },
  "homepage": "https://github.com/Not-Real-Studio/nr-md#readme",
  "bugs": {
    "url": "https://github.com/Not-Real-Studio/nr-md/issues"
  },
  "peerDependencies": {
    "ajv": "^8.12.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  }
}
